{
  "name": "@swarmbase/collabswarm-react",
  "description": "React hooks for Swarmbase collaborative documents",
  "version": "0.1.0",
  "homepage": "https://swarmbase.github.io/swarmbase/",
  "bugs": {
    "url": "https://github.com/swarmbase/swarmbase/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swarmbase/swarmbase.git",
    "directory": "packages/collabswarm-react"
  },
  "scripts": {
    "clean": "tsc -b --clean",
    "tsc": "tsc -b --clean && tsc -b",
    "prepublishOnly": "yarn tsc",
    "test": "jest",
    "tsc-watch": "tsc -w -p tsconfig.json",
    "test:coverage": "jest --coverage"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "!dist/**/__tests__/**",
    "!dist/**/__benchmarks__/**",
    "!dist/**/__mocks__/**",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo"
  ],
  "author": "allegrormc@gmail.com",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@peculiar/webcrypto": "^1.7.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.3",
    "eslint": "^10.4.1",
    "jest": "^29.2.5",
    "jest-environment-jsdom": "^30.3.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "redux": "^5.0.1",
    "redux-thunk": "^3.1.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@swarmbase/collabswarm": "workspace:^"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "jest": {
    "roots": [
      "<rootDir>/src"
    ],
    "testEnvironment": "jsdom",
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {}
      ]
    },
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1",
      "^@swarmbase/collabswarm$": "<rootDir>/../collabswarm/src/index.ts",
      "^@chainsafe/(.*)$": "<rootDir>/jest.empty-mock.js",
      "^@libp2p/(.*)$": "<rootDir>/jest.empty-mock.js",
      "^@helia/(.*)$": "<rootDir>/jest.empty-mock.js",
      "^@ipld/(.*)$": "<rootDir>/jest.empty-mock.js",
      "^helia$": "<rootDir>/jest.empty-mock.js",
      "^libp2p$": "<rootDir>/jest.empty-mock.js",
      "^ipns/(.*)$": "<rootDir>/jest.empty-mock.js",
      "^datastore-idb$": "<rootDir>/jest.empty-mock.js",
      "^blockstore-idb$": "<rootDir>/jest.empty-mock.js",
      "^it-pipe$": "<rootDir>/jest.empty-mock.js",
      "^bl$": "<rootDir>/jest.empty-mock.js",
      "^multiformats$": "<rootDir>/jest.empty-mock.js",
      "^multiformats/(.*)$": "<rootDir>/jest.empty-mock.js",
      "^@multiformats/multiaddr$": "<rootDir>/jest.empty-mock.js",
      "^uint8arraylist$": "<rootDir>/jest.empty-mock.js"
    },
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.test.ts",
      "!src/**/__mocks__/**"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ]
  }
}
